      "questions": [
        {
          "id": "q01",
          "text": "Ich melde mich oft."
        },
        {
          "id": "q02",
          "text": "Ich spreche deutlich, laut genug und in vollständigen Sätzen."
        },
        {
          "id": "q03",
          "text": "Ich passe gut auf und höre zu, wenn andere sprechen."
        },
        {
          "id": "q04",
          "text": "Ich frage nach, wenn ich etwas nicht verstanden habe."
        },
        {
          "id": "q05",
          "text": "Ich helfe mit, Fragen meiner Mitschüler zu beantworten."
        },
        {
          "id": "q06",
          "text": "Meine mündlichen Beiträge sind inhaltlich gut."
        },
        {
          "id": "q07",
          "text": "Ich verwende die mathematische Fachsprache."
        },
        {
          "id": "q08",
          "text": "Ich schwatze nicht und rufe nicht dazwischen."
        },
        {
          "id": "q09",
          "text": "Ich mache Lehrer und Mitschüler/innen auf Fehler aufmerksam."
        }
      ]
    },
